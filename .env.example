APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api/v1

PREDICTOR_BACKEND=mock
DATABASE_URL=sqlite:///./data/predictions/app.db

OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
WEATHER_LATITUDE=-7.9666
WEATHER_LONGITUDE=112.6326
WEATHER_TIMEZONE=Asia/Jakarta

PREDICTION_HORIZON_HOURS=3
RAIN_THRESHOLD_MM=0.1
RAIN_MODEL_DIR=models/rain-baseline-v1
RAIN_PREDICTION_DB_PATH=data/predictions/predictions.db

# Docker Compose: defaults preserve the existing VM storage paths.
API_PORT=8000
WEB_PORT=8080
MLFLOW_PORT=5000
PREDICTION_DATA_DIR=./data/predictions
MLFLOW_BACKEND_DIR=./data/mlflow/backend
MLFLOW_ARTIFACT_DIR=./data/mlflow/artifacts

# LK-10: only used with --profile serving, after mlflow models build-docker.
MODEL_SERVING_IMAGE=rain-risk-model:v2
MODEL_SERVING_PORT=5001
