{
  "name": "Rain Prediction MLOps",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/git-lfs:1": {}
  },
  "postCreateCommand": "python -m pip install uv==0.11.28 && uv sync --frozen --extra dev && npm --prefix frontend ci",
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-toolsai.jupyter",
        "eamodio.gitlens",
        "ms-azuretools.vscode-docker"
      ]
    }
  },
  "forwardPorts": [
    5173,
    8000,
    8080
  ],
  "portsAttributes": {
    "5173": {
      "label": "Frontend Vite"
    },
    "8000": {
      "label": "Backend FastAPI"
    },
    "8080": {
      "label": "Dashboard Docker"
    }
  },
  "remoteUser": "vscode"
  
}
